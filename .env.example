OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Free Groq stack (ears + brain on one key) ---
BRAIN_PROVIDER=groq
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Fast model for "hey Nova" / small talk (no tools)
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Optional local/cloud Ollama if BRAIN_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Local tiny: qwen3:0.6b | Local better: qwen3.5:4b | Cloud: glm-5:cloud, minimax-m2.7:cloud
OLLAMA_MODEL=glm-5:cloud

TTS_PROVIDER=auto
# Voice cascade: ElevenLabs (if keyed) → Kokoro-82M local → system TTS
KOKORO_VOICE=af_nova
KOKORO_SPEED=1.05
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Local Google Workspace MCP (CoPa) — preferred for real Gmail ---
# Re-auth when token expires: npm run gws:auth
# NOVA_GWS_MCP_DIR=C:\Users\User\Desktop\CoPa\google-workspace-mcp-server
# GOOGLE_CREDENTIALS_PATH=
# GOOGLE_TOKEN_PATH=

# Optional: Google's remote Gmail MCP (needs Developer Preview) — off by default
# NOVA_GMAIL_REMOTE=1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Qwen Audio 3.0 Realtime (Nova hologram stays; this is the voice runtime) ---
# Get a key: https://modelstudio.console.alibabacloud.com/
# Singapore/intl users: DASHSCOPE_REGION=intl
VOICE_RUNTIME=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=intl
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
QWEN_AUDIO_REALTIME_VOICE=longanqian
# QWEN_AUDIO_REALTIME_BASE_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime


