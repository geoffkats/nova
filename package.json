{
  "name": "holographic-ai-avatar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode singlefile",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "electron:start": "npm run build && electron .",
    "mcp:email": "node mcp/email/server.mjs",
    "gmail:auth": "node scripts/gmail-auth.mjs",
    "gws:auth": "python scripts/gws-auth.py"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "dotenv": "^17.4.2",
    "kokoro-js": "^1.2.1",
    "postprocessing": "^6.39.5",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.180.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
